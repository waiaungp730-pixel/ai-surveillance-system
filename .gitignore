# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual environments and local secrets
venv/
.venv/
.env
.env.*
!.env.example
.local_secrets.json
.sso_sessions.json
announcement_settings.json
cameras.json
nvr/go2rtc.yaml
nvr/nginx-snapshots.conf

# SQLite databases
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# Captured targets, face crops, and local data caches
data/
storage/
captures/
plate_captures/
exports/*.csv
uploads/
live_preview/
*.jpg
*.jpeg
*.png
*.webp
*.gif

# Model weights (download via download_*.py scripts)
*.pt
*.pth
*.onnx
*.caffemodel

# Sample / test media
video/
*.MOV
*.mp4

# Docker local state and logs
.docker/
*.log

# NVR binaries / runtime
nvr/go2rtc.exe
nvr/logs/
nvr/*.zip
