# Copy to .env and fill in. Never commit real values.

# Dashboard (required in production — otherwise auto-generated into .local_secrets.json)
FLASK_SECRET_KEY=
DASHBOARD_ADMIN_USER=admin
DASHBOARD_ADMIN_PASSWORD=
INTERNAL_ALERT_TOKEN=

# Bind (keep 127.0.0.1 unless behind a reverse proxy / VPN)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000

# Optional: allow folder scans outside the project dir (comma-separated)
# SCAN_ROOT_ALLOWLIST=E:\videos,D:\footage

# Optional Socket.IO CORS (comma-separated). Default: localhost:5000 only
# SOCKETIO_CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# Set to 1 when serving over HTTPS
# SESSION_COOKIE_SECURE=1

# Shared Dahua/Amcrest RTSP login (injected when cameras.json URLs have no user:pass)
RTSP_USER=admin
RTSP_PASSWORD=

# Telegram (optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Strangers only (default): non-watchlist=1, watchlist=0, named=0
# TELEGRAM_ALERT_NON_WATCHLIST=1
# TELEGRAM_ALERT_WATCHLIST=0
# TELEGRAM_ALERT_NAMED=0
# Capture only strangers — skip Named People gallery matches (watchlist/blacklist still save)
# CAPTURE_STRANGERS_ONLY=1
# TELEGRAM_ALERT_STYLE=collage
# TELEGRAM_ENHANCE_DISPLAY=0
# TELEGRAM_DISPLAY_MIN_SIDE=400

# Announcement schedule defaults (overridden by dashboard Settings page)
# ANNOUNCEMENT_START_TIME=08:00
# ANNOUNCEMENT_END_TIME=18:00

# Target Trace Scan — faster + better defaults
# VIDEO_SCAN_FRAME_INTERVAL=12
# VIDEO_SCAN_BATCH_SIZE=20
# VIDEO_SCAN_DETECT_SCALE=0.50
# VIDEO_SCAN_MAX_WIDTH=640
# VIDEO_SCAN_DETECT_UPSCALE=1.15
# VIDEO_SCAN_ADAPTIVE=1
# VIDEO_SCAN_YOLO_GATE=1
# FOLDER_SCAN_PARALLEL_WORKERS=6
# SCAN_ROOT_ALLOWLIST=D:\CCTV_Footage

# Capture thumbnails: person_box (live detect rectangle, default), upper_body, face, or full_frame
# CAPTURE_DISPLAY_MODE=person_box
# CAPTURE_PERSON_BOX_PAD_RATIO=0.02
# CAPTURE_DISPLAY_MODE=upper_body
# CAPTURE_DISPLAY_MODE=full_frame
# Saved face JPEGs: 0 = original square; 1 = GFPGAN/CLAHE on disk
# CAPTURE_FACE_ENHANCE=0
# All face outputs are padded/resized to this square size
# CAPTURE_OUTPUT_SIDE=256
# Tight face crop = detector box (0 = hairline-to-chin like the live red square)
# CAPTURE_FACE_PAD=0
# Saved scene JPEGs: 0 = original frame; 1 = red face box burned in
# CAPTURE_SCENE_DRAW_BOX=0
# CAPTURE_DISPLAY_DRAW_FACE_BOX=0

# License plate detection (YOLOv8 plate detector + PaddleOCR worker)
# ENABLE_LICENSE_PLATE=1
# LICENSE_PLATE_CAMERAS=all
# LICENSE_PLATE_CAMERAS=3,28,29,30
# LICENSE_PLATE_OCR_EVERY=2
# LICENSE_PLATE_MIN_OCR=0.55
# LICENSE_PLATE_COOLDOWN_SEC=900
# LICENSE_PLATE_CAMERA_COOLDOWN_SEC=60
# Multi-frame vote before save (more accurate plate text at capture time)
# LICENSE_PLATE_VOTE_MIN=3
# LICENSE_PLATE_VOTE_WINDOW_SEC=2.5
# LICENSE_PLATE_VOTE_MAX_WAIT_SEC=4.0
# OCR engine: paddle (default) or easy
# LICENSE_PLATE_OCR=paddle
# Dedicated plate weights (otherwise vehicle bumper OCR fallback):
# LICENSE_PLATE_MODEL=D:\ai-surveillance-system-main\license_plate_detector.pt

# Auto-delete saved captures every 2 weeks: export CSV to exports/, then delete
# CAPTURE_RETENTION_DAYS=14
# LOG_RETENTION_DAYS=14
# CAPTURE_CLEANUP_INTERVAL_SEC=86400
